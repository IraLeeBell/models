  "capabilities": [
    {
      "text": "Grok 4.6 extends Grok 4.5 and is described as better at autonomous, challenging tasks with fewer steps and fewer output tokens than other frontier models.",
      "pages": [6],
      "document": "xai-grok-4-6"
    },
    {
      "text": "Training adds a longer supplemental phase than Grok 4.5, including curated model-generated data, engineering corpora, an improved optimizer, Grok 4.5-generated SFT traces, and agentic RL across knowledge work, coding, kernels, web development, and CAD.",
      "pages": [7],
      "document": "xai-grok-4-6"
    },
    {
      "text": "Coding evaluations cover Cursor IDE workflows, observability/integration tasks, maintainer-style PR quality, repository repair, multi-hour tasks, and terminal work.",
      "pages": [8, 10, 11, 12, 13, 14],
      "document": "xai-grok-4-6"
    },
    {
      "text": "Knowledge-work evaluations span GDPval-AA v2, AA-Briefcase, APEX-Agents, OfficeQA Pro, and legal-agent tasks with file, shell, and document skills.",
      "pages": [15, 16, 17, 18, 19],
      "document": "xai-grok-4-6"
    },
    {
      "text": "Engineering and CAD results include EEBench, 3DCodeBench, PartBench, CADGenBench, and CADBench, with several gains over Grok 4.5.",
      "pages": [20, 21, 22, 23],
      "document": "xai-grok-4-6"
    },
    {
      "text": "AI R&D capability is tested through a production inference-optimization exercise, SpaceXAI MTS Eval, InferenceEval, and KernelBenchInternal v1.1.",
      "pages": [24, 25, 26],
      "document": "xai-grok-4-6"
    },
    {
      "text": "Search and factuality are explicitly measured, but hallucination rises to 1.7% while DeepSearchQA falls behind the Grok 4.5 comparison row.",
      "pages": [27, 28],
      "document": "xai-grok-4-6"
    }
  ],
