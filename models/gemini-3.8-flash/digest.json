  "capabilities": [
    {
      "text": "Google describes 3.8 Flash as the next Flash iteration, built on 3.7 Flash, with advances in software engineering and agentic knowledge workflows.",
      "pages": [2],
      "document": "google-gemini-3-8-flash"
    },
    {
      "text": "The model keeps multimodal input, long context, and long text output from recent Flash cards.",
      "pages": [2],
      "document": "google-gemini-3-8-flash"
    },
    {
      "text": "Google says effort settings can be customized to balance answer quality, latency, and token usage.",
      "pages": [2],
      "document": "google-gemini-3-8-flash"
    },
    {
      "text": "Distribution channels named by the publisher include Gemini app, Gemini API, Google AI Studio, AI Mode, Antigravity, and an enterprise agent platform.",
      "pages": [3, 4],
      "document": "google-gemini-3-8-flash"
    },
    {
      "text": "The chart reports 73.7% on DeepSWE, 89.4% on Terminal-Bench 2.1, 59.0 on the OSWorld computer-use row, and 61.4% on Vals Finance Agent v2.",
      "pages": [5],
      "document": "google-gemini-3-8-flash"
    }
