  "capabilities": [
    {
      "text": "The card describes Gemini 2.5 Pro as Google’s most advanced complex-task model at the time, able to handle text, audio, image, video, and whole-code-repository inputs.",
      "pages": [2],
      "document": "google-gemini-2-5-pro"
    },
    {
      "text": "Gemini 2.5 models are sparse mixture-of-experts transformers with native multimodal support.",
      "pages": [2],
      "document": "google-gemini-2-5-pro"
    },
    {
      "text": "Training data included public web documents, code, images, audio, video, instruction-tuning data, preferences, and tool-use data, with deduplication, safety filtering, and quality filtering.",
      "pages": [3],
      "document": "google-gemini-2-5-pro"
    },
    {
      "text": "The evaluation setup distinguishes single-attempt and multiple-attempt settings, provider-sourced comparison numbers, thinking versus non-thinking comparators, and MRCR v2 methodology changes.",
      "pages": [4],
      "document": "google-gemini-2-5-pro"
    },
    {
      "text": "Intended uses are enhanced reasoning, advanced coding, multimodal understanding, and long context.",
      "pages": [7],
      "document": "google-gemini-2-5-pro"
    },
    {
      "text": "GA benchmark rows include 86.4% on GPQA Diamond, 82.2% on Aider Polyglot, 87.8% on FACTS Grounding, 86.9% on VideoMME, and 89.2% on Global MMLU Lite.",
      "pages": [5, 6],
      "document": "google-gemini-2-5-pro"
    }
