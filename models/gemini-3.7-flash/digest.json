  "capabilities": [
    {
      "text": "Google says 3.7 Flash adds algorithmic reasoning improvements over 3.6 Flash and supports agentic video understanding.",
      "pages": [2],
      "document": "google-gemini-3-7-flash"
    },
    {
      "text": "The interface includes text, image, audio, and video inputs with a 1M-token context window and text output up to 64K tokens.",
      "pages": [2],
      "document": "google-gemini-3-7-flash"
    },
    {
      "text": "The card says thinking configurations are customizable for task demands, but it does not enumerate the levels.",
      "pages": [2],
      "document": "google-gemini-3-7-flash"
    },
    {
      "text": "Intended uses include agentic workflows, complex video reasoning, coding tasks, and enterprise workflows.",
      "pages": [5],
      "document": "google-gemini-3-7-flash"
    },
    {
      "text": "The chart reports broad gains over its predecessor, including FrontierCode Main at 43.6%, DeepSWE at 65.3%, and the OSWorld computer-use row at 47.9%.",
      "pages": [5],
      "document": "google-gemini-3-7-flash"
    }
