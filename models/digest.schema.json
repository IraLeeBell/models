          "type": ["string", "null"],
          "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
        },
        "format": {
          "enum": ["pdf", "markdown"]
        },
        "pages": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "supplements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "title", "date", "pages"],
